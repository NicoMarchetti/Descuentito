# Con el backend viviendo en el mismo proyecto de Vercel (ver vercel.json
# en la raíz), el frontend le pega a /api/... con ruta relativa -- NO
# hace falta configurar VITE_API_BASE en absoluto. Si la tenías puesta
# desde antes en Vercel, podés borrarla.
#
# Solo la necesitarías si en algún momento separás el backend a otro
# dominio (tu server, Render, etc.):
# VITE_API_BASE=https://tu-backend.tudominio.com
